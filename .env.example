# Fianto — local settings. Read at startup; never committed (.gitignore).
# Anthropic key for the default provider (https://platform.claude.com/settings/keys).
# Without it scans still run and automated summaries are written; other providers can be added on /settings.
ANTHROPIC_API_KEY=

# ---- Models (seed values for the Settings page on first start; the dashboard's stage assignment wins afterwards)
# CLAUDE_MODEL=claude-opus-5-5           # reports
# CLAUDE_AGENT_MODEL=claude-opus-5-5     # surface review agents
# CLAUDE_VERIFY_MODEL=claude-opus-5-5    # adversarial verifier (claude-fable-5-1 / claude-mythos-5-1 for deeper reasoning)
# CLAUDE_PATCH_MODEL=claude-opus-5-5     # patch agent
# CLAUDE_EFFORT=high                     # low | medium | high | xhigh | max
# CLAUDE_MAX_TOKENS=64000                # output ceiling per report
# CLAUDE_FALLBACKS=default               # "off" disables the server-side refusal fallback
# CLAUDE_MAX_INPUT_CHARS=350000          # scanner evidence budget per report call

# ---- Pipeline
# RUN_DEPTH=verify                       # scan | review | verify | patch (default on the launch page)
# AGENT_PARALLELISM=4                    # surface agents run concurrently per repo
# AGENT_MAX_ITERATIONS=45                # tool-call turn caps
# VERIFY_MAX_ITERATIONS=35
# PATCH_MAX_ITERATIONS=40
# VERIFY_MAX_CANDIDATES=25               # findings per repo sent to the verifier
# PATCH_MAX_PER_PROJECT=3                # auto-patches per repo at depth=patch
# PATCH_MIN_SEVERITY=high
# SCANNER_TIMEOUT_SECONDS=1800

# ---- App
# SCANNER_DATA_DIR=./data                # runs, findings.db, worktrees, settings.json
# APP_NAME=Fianto
# PORT=8000
